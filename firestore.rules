rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // TROQUE pelos e-mails de vocês dois (os mesmos da variável NEXT_PUBLIC_ALLOWED_EMAILS)
    function isUs() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in ['voce@gmail.com', 'namorada@gmail.com'];
    }

    match /recipes/{recipeId} {
      allow read, write: if isUs();
    }
  }
}
